# Copy this file to .env and fill in what you use. .env is git-ignored: never commit it.
# Each value can also be set as an environment variable of the same name.

# ── Tablet (required) ────────────────────────────────────────────────────────
# On the tablet: Settings → Help → Copyrights and licenses → scroll to the bottom.
# The password is only used once by `tabloid tablet setup`, which installs an SSH key.
RM_HOST=10.11.99.1          # 10.11.99.1 over USB, or the tablet's Wi-Fi IP
RM_USER=root
RM_PASSWORD=

# ── Air quality from a real ground station (optional) ────────────────────────
# Free token, emailed instantly: https://aqicn.org/data-platform/token/
# Without it, tabloid uses Open-Meteo's modelled AQI (no key, but less accurate in some cities).
WAQI_TOKEN=

# ── TickTick tasks (optional) ────────────────────────────────────────────────
# 1. https://developer.ticktick.com → Manage Apps → + App Name
# 2. Set the OAuth redirect URL to  http://127.0.0.1:8765/callback
# 3. Paste the app's Client ID and Client Secret below, then run `tabloid ticktick login`.
#    The login writes TICKTICK_TOKEN (and refresh info) to this file for you.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
